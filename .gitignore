nix/modules/darwin/homebrew.local.nix

# Python バイトコードキャッシュ (claude/skills/*/scripts/ 等の Python スクリプト実行時に生成される)
__pycache__/
*.pyc

# Codex / ChatGPT desktop アプリが動的に書き換える running config。
# 静的な seed は codex/config.base.toml に置き、~/.codex/config.toml は
# アプリ所有の実体ファイルとして追跡しない (nix/modules/home/codex.nix 参照)。
.codex/config.toml
