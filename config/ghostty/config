# ---- 見た目 ----
theme = Catppuccin Mocha

# 欧文は JetBrains Mono、和文はグリフを持たないため 2 つ目の UDEV Gothic LG へ
# フォールバックする (フォント導入の理由は nix/modules/darwin/fonts.nix)。
# LG バリアントは行送りを広げた版で、既定版だと和文の行が詰まって潰れて見える。
font-family = JetBrains Mono
font-family = UDEV Gothic LG
font-size = 12

# macOS の CoreText はグリフを細く描くため、暗い背景では和文の画が飛ぶ。
font-thicken = true

# 既定の 2px は文字が窓枠に張り付いて見えるため広げる。balance は
# 端数を上下左右に均等配分し、ウィンドウサイズによって余白が偏るのを防ぐ。
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# ---- SSH ----
# xterm-ghostty の terminfo は ghostty 同梱のため接続先には存在せず、
# TERM をそのまま渡すとリモートの起動スクリプトが terminfo 参照で失敗する。
# ssh-terminfo が初回接続時に infocmp の出力を送って相手側へ登録する。
# この項目は加算ではなく置き換えなので、既定値 (cursor,no-sudo,title,
# no-ssh-env,no-ssh-terminfo,path) を全部書いた上で ssh 系だけ反転させる。
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
