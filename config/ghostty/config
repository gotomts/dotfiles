# ---- 見た目 ----
theme = Catppuccin Mocha

# 欧文は JetBrains Mono、和文はグリフを持たないため 2 つ目の UDEV Gothic LG へ
# フォールバックする (フォント導入の理由は nix/modules/darwin/fonts.nix)。
# LG バリアントは行送りを広げた版で、既定版だと和文の行が詰まって潰れて見える。
font-family = JetBrains Mono
font-family = UDEV Gothic LG
font-size = 12

# macOS の CoreText はグリフを細く描くため、暗い背景では和文の画が飛ぶ。
font-thicken = true

# 既定の 2px は文字が窓枠に張り付いて見えるため広げる。balance は
# 端数を上下左右に均等配分し、ウィンドウサイズによって余白が偏るのを防ぐ。
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# ---- SSH ----
# xterm-ghostty の terminfo は ghostty 同梱のため接続先には存在せず、
# TERM をそのまま渡すとリモートの起動スクリプトが terminfo 参照で失敗する。
# ssh-terminfo が初回接続時に infocmp の出力を送って相手側へ登録する。
# この項目は加算ではなく置き換えなので、既定値 (cursor,no-sudo,title,
# no-ssh-env,no-ssh-terminfo,path) を全部書いた上で ssh 系だけ反転させる。
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# ---- herdr 前提 ----
# 有効なキーボードレイアウトが ABC のため macos-option-as-alt の既定は
# false になり (true になるのは U.S. Standard / U.S. International のみ)、
# Option を押しても Alt シーケンスが端末に届かず herdr の alt 系キーバインドが
# 無反応になる。左 Option だけ Alt 扱いにして、右 Option には macOS の
# Unicode 入力 (option-b で "∫" 等) を残す。
macos-option-as-alt = left

# Cmd 系のタブ / 分割操作を ghostty 自身ではなく herdr に流す。Cmd は端末に
# 届かず herdr 側では受けられないため、ghostty で herdr の prefix シーケンス
# に変換して送る。\x02 = Ctrl+B (herdr の prefix)。
# herdr の [keys] を変えたらここも追従させること。
#
# この変換は herdr の外 (素のシェルを開いただけの窓) でも無条件に効くので、
# ghostty は herdr 専用という前提を置いている。ウィンドウを閉じたいときは
# ghostty 既定のまま残してある Cmd+Shift+W を使う。
keybind = super+t=text:\x02c
keybind = super+w=text:\x02X
keybind = super+d=text:\x02v
keybind = super+shift+d=text:\x02-
keybind = super+x=text:\x02x
# detach だけ Ctrl 系に置く。Cmd と Q の組み合わせは Apple メニューの
# ログアウト / ロックに取られてアプリ側では奪えない (symbolichotkeys には
# 登録が無く、常時存在する Apple メニューのショートカットとして優先される)。
keybind = ctrl+shift+q=text:\x02q

# タブ番号への直接ジャンプ (herdr の switch_tab = prefix+1..9)。
# ghostty 既定は同じ操作を super+digit_N と super+N の 2 つで定義しており、
# 片方だけ潰すともう片方から ghostty 自身の goto_tab が生き残るため両方書く。
keybind = super+digit_1=text:\x021
keybind = super+1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+8=text:\x028
keybind = super+digit_9=text:\x029
keybind = super+9=text:\x029

# 停止した agent を Ctrl+. 一発で再開する。押した瞬間に送信されるので、
# 入力中のテキストが残っていると連結されたまま飛ぶ点に注意。
#
# 素のテキストで送ると Claude Code の TUI は一括で届いたバイト列を 1 キー入力
# として扱い先頭の "c" しか拾わない。bracketed paste (\x1b[200~ ... \x1b[201~)
# で囲んで「一括入力」と明示し、続く \r で送信する。
keybind = ctrl+.=text:\x1b[200~continue\x1b[201~\r
